# AetherHealth Environment Configuration
# Advantix Cloud & SaaS Engineering Challenge UC-03

PORT=3000
NODE_ENV=development

# Database Configuration
# Default: High-throughput SQLite 3 with Write-Ahead Logging (WAL)
DB_PATH=./app.db

# Optional: Azure SQL Database Connection String
# When set, the system connects via mssql pool to the remote Azure SQL instance
# AZURE_SQL_CONNECTION_STRING="Server=tcp:sql-codessey-dev.database.windows.net,1433;Database=sqldb-codessey;User ID=azureuser;Password=YourPassword123!;Encrypt=true;TrustServerCertificate=false;"

# Optional: Google Gemini API Key
# When set, Aether Intelligence Copilot calls live Gemini 1.5 Flash for telemetry analysis.
# When omitted, the built-in domain intelligence engine responds locally with 0ms latency.
GEMINI_API_KEY=""
